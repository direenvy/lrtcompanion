node_modules/
.next/
out/
.turbo/
.swc/
next-env.d.ts
.npm/
.eslintcache
*.tsbuildinfo

# ── Model weights / large caches ──────────────────────────────────
# Whisper weights are ~1.5 GB and download on first use.
# Large caches (embeddings, ingest state, partials) stay out — they either
# regenerate on demand or are per-machine state. The two small NLP baseline
# classifiers are whitelisted below so they ship with the deployment (Render
# has no training corpus to rebuild them from).
# GitHub blocks single files > 100 MB anyway.
backend/models/*.joblib
backend/models/*.pkl
backend/models/*.bin
backend/models/*.safetensors
backend/models/x_ingest_state.json
backend/models/rag_embeddings_cache*.pkl
backend/models/*.partial.pkl
!backend/models/sentiment_baseline.joblib
!backend/models/issue_type_baseline.joblib

# HuggingFace / Whisper caches (usually in home dir but just in case)
.cache/
huggingface/

# ── Data — usually keep the CSVs (small), skip generated artefacts ─
# The chunked corpus is a build artefact — regenerable from source PDFs.
data/rag/outputs/*.jsonl
data/nlp/interim/live_x_labelling.csv

# Everything under data/ that's a build artefact
data/**/*.parquet
data/**/*.arrow

# ── OS junk ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
._*

